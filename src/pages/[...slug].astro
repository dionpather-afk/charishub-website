---
// Every page of the site is built ahead of time as plain HTML (no server, no
// Wix). Each page gets its own title, description and share-preview tags so
// WhatsApp, Facebook and search engines see them without running JavaScript.
import { Head } from "@/components/Head";
import AppRouter from "@/components/Router";
import {
  SITE_NAME,
  DEFAULT_OG_IMAGE,
  DEFAULT_OG_IMAGE_ALT,
  SITE_URL,
  PAGE_SEO,
  getPageSeo,
  getCanonicalUrl,
  buildChurchJsonLd,
  toJsonLd,
} from "@/lib/seo";
import goldLogo from "@/assets/rca-charisma-logo-gold.png?url";
import "@/styles/wix-plugins-vars.css";
import "@/styles/wix-plugins-theme.css";
import "@/styles/global.css";

export function getStaticPaths() {
  return Object.keys(PAGE_SEO).map((path) => ({
    params: { slug: path === '/' ? undefined : path.slice(1) },
  }));
}

const pagePath = '/' + (Astro.params.slug || '');
const pageSeo = getPageSeo(pagePath);
const pageUrl = getCanonicalUrl(pagePath);
const churchJsonLd = toJsonLd(buildChurchJsonLd(SITE_URL, new URL(goldLogo, SITE_URL).href));

// Search engines: indexing approved by Dion on 24 Nov 2026 (site live on Xneelo).
// Build with SITE_INDEXING=off to hide the site from Google again.
const allowIndexing = import.meta.env.SITE_INDEXING !== 'off';
---

<html lang="en" class="w-full h-full">
  <head>
    <Head />
    <title>{pageSeo.title}</title>
    <meta name="description" content={pageSeo.description} />
    {!allowIndexing && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" type="image/png" href={goldLogo} />
    <meta property="og:title" content={pageSeo.title} />
    <meta property="og:description" content={pageSeo.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:image" content={DEFAULT_OG_IMAGE} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={DEFAULT_OG_IMAGE_ALT} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageSeo.title} />
    <meta name="twitter:description" content={pageSeo.description} />
    <meta name="twitter:image" content={DEFAULT_OG_IMAGE} />
    <meta name="twitter:image:alt" content={DEFAULT_OG_IMAGE_ALT} />
    <script type="application/ld+json" is:inline set:html={churchJsonLd} />
  </head>
  <body class="w-full h-full">
    <div id="root" class="w-full h-full">
      <AppRouter client:only="react" />
    </div>
  </body>
</html>
